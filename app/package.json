{
  "name": "aim-trainer",
  "productName": "AimTrainer",
  "version": "1.3.0",
  "description": "Offline desktop version of the open-aim trainer",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prestart": "node ../scripts/build-scenarios.mjs",
    "start": "electron .",
    "prebuild": "node ../scripts/build-scenarios.mjs",
    "build": "electron-builder --win portable nsis",
    "check": "node ../scripts/build-scenarios.mjs --check",
    "test:import": "node --test ../scripts/test-valorant-import.cjs",
    "test:guards": "node --test ../scripts/test-shell-guards.cjs",
    "test:variants": "node --test ../scripts/test-drill-variants.cjs",
    "test:spots": "node --test ../scripts/test-spot-bias.cjs",
    "test:vary": "node --test ../scripts/test-spot-vary.cjs",
    "test:round": "node --test ../scripts/test-round.mjs ../scripts/test-round-sim.mjs ../scripts/test-round-nav.mjs ../scripts/test-round-bots.mjs ../scripts/test-round-bots-real.mjs ../scripts/test-round-bots-real-rook.mjs ../scripts/test-round-bots-real-bonsai.mjs ../scripts/test-round-bots-parity.mjs ../scripts/test-round-bots-attack.mjs ../scripts/test-round-bots-attack-rook.mjs ../scripts/test-round-bots-attack-bonsai.mjs ../scripts/test-round-ui.mjs ../scripts/test-round-minimap.mjs",
    "sweep:round-bots": "node ../scripts/round-bots-sweep.mjs",
    "test:maps-location": "node --test ../scripts/test-maps-location.mjs",
    "test:shell": "node --test ../scripts/test-shell-hardening.cjs",
    "test:feelsens": "node --test ../scripts/test-feel-sens.cjs",

    "test:maps": "node --test ../scripts/test-maps-callouts.mjs ../scripts/test-maps-previews.mjs",
    "test:result": "node --test ../scripts/test-ux-result.mjs",
    "test:words": "node --test ../scripts/test-ux-words.mjs",
    "test:training-hooks": "node --test ../scripts/test-training-hooks.mjs ../scripts/test-training-launch.mjs",
    "test:training": "node --test ../scripts/test-training-scenarios.mjs",
    "test:peekers": "node --test ../scripts/test-training-peekers.mjs",
    "test:feelaudio": "node --test ../scripts/test-feel-audio.cjs",
    "test:feelaudiopatch": "node --test ../scripts/test-feel-audio-patch.cjs",
    "test:feelxbloom": "node --test ../scripts/test-feel-xbloom.mjs",
    "test:feelxprof": "node --test ../scripts/test-feel-xprofiles.cjs",
    "test:feelcstrafe": "node --test ../scripts/test-feel-cstrafe.cjs ../scripts/test-feel-cstrafe-sim.mjs",
    "test:graphics-look": "node --test ../scripts/test-graphics-look.mjs",
    "test:stats": "node --test ../scripts/test-training-stats.mjs",
    "test:progress": "node --test ../scripts/test-training-progress.cjs",
    "test:practice": "node --test ../scripts/test-practice.mjs",
    "test:routines": "node --test ../scripts/test-training-routines.cjs",
    "test:graphics-fx": "node --test ../scripts/test-graphics-fx.mjs",
    "test:graphics-botfx": "node --test ../scripts/test-graphics-botfx.mjs",
    "test:hit": "node --test ../scripts/test-ux-hit.mjs",
    "test:hud": "node --test ../scripts/test-ux-hud.mjs",
    "test:cards": "node --test ../scripts/test-ux-cards.mjs",
    "test:theme": "node --test ../scripts/test-ux-result-theme.mjs",
    "test:welcome": "node --test ../scripts/test-ux-welcome.mjs",
    "test:feelsensfinder": "node --test ../scripts/test-feel-sens-finder.cjs",
    "test:map-sky": "node --test ../scripts/test-map-sky.mjs",
    "test:map-salt": "node --test ../scripts/test-map-salt.mjs",
    "test:smokelib": "node --test ../scripts/smoke/lib.test.mjs",
    "smoke": "node ../scripts/smoke/run.mjs"
  },
  "build": {
    "appId": "local.aimtrainer.offline",
    "productName": "AimTrainer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui.css",
      "theme-esports.css",
      "lobby-bar.js",
      "frame-meter.js",
      "video-settings.js",
      "lighting-settings.js",
      "bot-settings.js",
      "rank-picker.js",
      "round-panel.js",
      "round-hud.js",
      "ux-keys.js",
      "ux-hud.js",
      "ux-result.js",
      "ux-welcome.js",
      "round-scene.js",
      "practice-scene.js",
      "practice-panel.js",
      "drill-variants.js",
      "interface-mode.js",
      "startup-screen.js",
      "page-watch.js",
      "smooth-scroll.js",
      "player-tools.js",
      "feel-sens-finder-core.js",
      "feel-sens-finder.js",
      "valorant-import.js",
      "valorant-import-ui.js",
      "valorant-import-ipc.js",
      "feel-crosshair-profiles.js",
      "valorant-import.css",
      "backups.js",
      "shell-log.js",
      "shell-env.js",
      "local-guard.js",
      "offline.css",
      "studio-store.js",
      "studio-launch.js",
      "training-launch.js",
      "shooting-error.js",
      "aim-tick-hub.js",
      "maps-location.js",
      "studio/**/*",
      "training-set.json",
      "translations.js",
      "english-fixes.js",
      "build/icon.ico",
      "package.json",
      "local-customization.js",
      "fan-audio.js",
      "feel-audio.js",
      "sniper-scopes.js",
      "advanced-tracers.js",
      "training-analytics-core.js",
      "training-analytics.js",
      "training-progress-core.js",
      "training-progress.js",
      "training-progress.css",
      "training-routines-core.js",
      "training-routines.js",
      "training-routines.css"
    ],
    "extraResources": [
      {
        "from": "../site",
        "to": "site"
      },
      {
        "from": "../site_meta.json",
        "to": "site_meta.json"
      },
      {
        "from": "mods",
        "to": "mods"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "AimTrainer.exe"
    },
    "nsis": {
      "artifactName": "AimTrainer-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AimTrainer",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  }
}
