{
  "name": "aim-trainer",
  "productName": "AimTrainer",
  "version": "1.3.0",
  "description": "Offline desktop version of the open-aim trainer",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prestart": "node ../scripts/build-scenarios.mjs",
    "start": "electron .",
    "prebuild": "node ../scripts/build-scenarios.mjs",
    "build": "electron-builder --win portable nsis",
    "check": "node ../scripts/build-scenarios.mjs --check",
    "test:import": "node --test ../scripts/test-valorant-import.cjs",
    "test:guards": "node --test ../scripts/test-shell-guards.cjs",
    "test:variants": "node --test ../scripts/test-drill-variants.cjs",
    "test:spots": "node --test ../scripts/test-spot-bias.cjs",
    "test:vary": "node --test ../scripts/test-spot-vary.cjs",
    "test:round": "node --test ../scripts/test-round.mjs ../scripts/test-round-sim.mjs",
    "test:feelxprof": "node --test ../scripts/test-feel-xprofiles.cjs"
  },
  "build": {
    "appId": "local.aimtrainer.offline",
    "productName": "AimTrainer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui.css",
      "theme-esports.css",
      "lobby-bar.js",
      "frame-meter.js",
      "video-settings.js",
      "lighting-settings.js",
      "bot-settings.js",
      "rank-picker.js",
      "round-panel.js",
      "round-hud.js",
      "round-scene.js",
      "drill-variants.js",
      "interface-mode.js",
      "startup-screen.js",
      "page-watch.js",
      "smooth-scroll.js",
      "player-tools.js",
      "valorant-import.js",
      "valorant-import-ui.js",
      "valorant-import-ipc.js",
      "feel-crosshair-profiles.js",
      "valorant-import.css",
      "backups.js",
      "local-guard.js",
      "offline.css",
      "studio-store.js",
      "studio-launch.js",
      "shooting-error.js",
      "studio/**/*",
      "training-set.json",
      "translations.js",
      "english-fixes.js",
      "build/icon.ico",
      "package.json",
      "local-customization.js",
      "fan-audio.js",
      "sniper-scopes.js",
      "advanced-tracers.js"
    ],
    "extraResources": [
      {
        "from": "../site",
        "to": "site"
      },
      {
        "from": "../site_meta.json",
        "to": "site_meta.json"
      },
      {
        "from": "mods",
        "to": "mods"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "AimTrainer.exe"
    },
    "nsis": {
      "artifactName": "AimTrainer-Setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AimTrainer",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  }
}
